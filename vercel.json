{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/:file(logo\\.png|vite\\.svg|profile\\.jpg|favicon\\.ico)",
      "destination": "/frontend/:file"
    },
    {
      "source": "/((?!api|uploads|assets).*)",
      "destination": "/frontend/index.html"
    }



  ]
}